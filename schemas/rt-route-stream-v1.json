{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/larsbx/novelty-lab/blob/main/schemas/rt-route-stream-v1.json",
  "title": "Finite F5 route-stream receipt v1 — bounded consumer experiment",
  "description": "Structural wire schema only. Exact canonical JSON, trusted pin, update semantics, permutation order, guard evaluation and record replay are additionally enforced by event_stream_v1.py; this schema is not a proof of authenticity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "spec",
    "spec_sha256",
    "requests",
    "records",
    "records_sha256",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "rt-route-stream/v1"
    },
    "spec": {
      "$ref": "#/$defs/spec"
    },
    "spec_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "requests": {
      "oneOf": [
        {
          "const": "all"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edgeRequest"
          }
        }
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "records_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    }
  },
  "$defs": {
    "coordinate": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "vector": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coordinate"
      },
      "minItems": 8,
      "maxItems": 8
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "offset",
        "gain",
        "probe",
        "shear"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "offset": {
          "$ref": "#/$defs/vector"
        },
        "gain": {
          "$ref": "#/$defs/coordinate"
        },
        "probe": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "shear": {
          "$ref": "#/$defs/vector"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "initial",
        "updates",
        "direction_rank",
        "gate"
      ],
      "properties": {
        "field": {
          "const": 5
        },
        "initial": {
          "$ref": "#/$defs/vector"
        },
        "updates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/update"
          },
          "minItems": 3,
          "maxItems": 5
        },
        "direction_rank": {
          "enum": [
            1,
            2
          ]
        },
        "gate": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/coordinate"
          }
        }
      }
    },
    "permutation": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4
      }
    },
    "edgeRequest": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/permutation"
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target",
        "position",
        "prefix",
        "after_a",
        "after_b",
        "after_ab",
        "after_ba",
        "directions",
        "spreads",
        "residual",
        "geometric_pass",
        "effect_equal",
        "admitted"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/permutation"
        },
        "target": {
          "$ref": "#/$defs/permutation"
        },
        "position": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "prefix": {
          "$ref": "#/$defs/vector"
        },
        "after_a": {
          "$ref": "#/$defs/vector"
        },
        "after_b": {
          "$ref": "#/$defs/vector"
        },
        "after_ab": {
          "$ref": "#/$defs/vector"
        },
        "after_ba": {
          "$ref": "#/$defs/vector"
        },
        "directions": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/vector"
          }
        },
        "spreads": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/coordinate"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "residual": {
          "$ref": "#/$defs/vector"
        },
        "geometric_pass": {
          "type": "boolean"
        },
        "effect_equal": {
          "type": "boolean"
        },
        "admitted": {
          "type": "boolean"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coherence_labels",
        "direction_rank",
        "potential_edges",
        "audited_edges",
        "admitted_edges",
        "geometric_edges",
        "blocked_effect_edges",
        "nonzero_null_residuals",
        "P4_admitted_faces",
        "P4_top_cell",
        "scope"
      ],
      "properties": {
        "coherence_labels": {
          "type": "integer",
          "minimum": 3,
          "maximum": 5
        },
        "direction_rank": {
          "enum": [
            1,
            2
          ]
        },
        "potential_edges": {
          "type": "integer",
          "minimum": 0
        },
        "audited_edges": {
          "type": "integer",
          "minimum": 0
        },
        "admitted_edges": {
          "type": "integer",
          "minimum": 0
        },
        "geometric_edges": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_effect_edges": {
          "type": "integer",
          "minimum": 0
        },
        "nonzero_null_residuals": {
          "type": "integer",
          "minimum": 0
        },
        "P4_admitted_faces": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 14
            },
            {
              "type": "null"
            }
          ]
        },
        "P4_top_cell": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "enum": [
            "complete",
            "requested-only"
          ]
        }
      }
    }
  }
}
